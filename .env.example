# Copy to .env (gitignored) and fill in. Secrets never go into .config.yaml or logs.

# optional: empty = use `gh auth token`
REPKA_GITHUB_TOKEN=

# Telegram app credentials (https://my.telegram.org); passed only to the fast-mcp-telegram subprocess (`repka notify login`, sending)
REPKA_TG_API_ID=
REPKA_TG_API_HASH=
