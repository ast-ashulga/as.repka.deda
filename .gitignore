# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# repka local state and secrets (never commit)
.env
.sessions/
.state/
logs/

# Local, personal domains stay untracked: domains/*.yaml is ignored, except the shipped examples
# (domains/example-*.yaml and everything under domains/examples/). Already tracked files are unaffected.
/domains/*.yaml
!/domains/example-*.yaml
!/domains/examples/

# Scratch homes for rehearsals (REPKA_HOME=...)
scratch/
.scratch/
tmp-home*/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local worktrees
.claude/worktrees/

# Keep the lockfile tracked even if a global gitignore hides it
!uv.lock
